generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrgType {
  SUPPLIER
  MERCHANT
  ADMIN
}

enum OrgMemberRole {
  OWNER
  ADMIN
  STAFF
}

enum MerchantSupplierStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum Provider {
  SHOPEE
  MERCADOLIVRE
}

enum FulfillmentStatus {
  NEW
  CONFIRMED
  SHIPPED
  CANCELLED
}

enum ReservationStatus {
  HELD
  RELEASED
  CONSUMED
}

model Org {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  type      OrgType
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  members               OrgMember[]
  products              Product[]          @relation("SupplierProducts")
  supplierOffers        SupplierOffer[]    @relation("SupplierOffers")
  merchantSuppliersAsM  MerchantSupplier[] @relation("MerchantAsMerchant")
  merchantSuppliersAsS  MerchantSupplier[] @relation("MerchantAsSupplier")
  integrations          Integration[]
  listings              Listing[]          @relation("MerchantListings")
  marketplaceOrders     MarketplaceOrder[] @relation("MerchantOrders")
  fulfillmentAsSupplier FulfillmentOrder[] @relation("FulfillmentSupplier")
  fulfillmentAsMerchant FulfillmentOrder[] @relation("FulfillmentMerchant")
  idempotencyKeys       IdempotencyKey[]

  @@map("orgs")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String?  @map("full_name")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  orgs OrgMember[]

  @@map("users")
}

model OrgMember {
  orgId  String        @map("org_id") @db.Uuid
  userId String        @map("user_id") @db.Uuid
  role   OrgMemberRole

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@map("org_members")
}

model Product {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierOrgId String   @map("supplier_org_id") @db.Uuid
  
  // Basic fields
  title         String
  description   String?
  brand         String?
  isActive      Boolean  @default(true) @map("is_active")
  
  // Brazilian product fields
  codigo                        String?  @map("codigo")
  unidade                       String?  @map("unidade")
  ncm                           String?  @map("ncm")
  origem                        String?  @map("origem")
  preco                         Decimal? @map("preco") @db.Decimal(10, 2)
  valorIpiFixo                  Decimal? @map("valor_ipi_fixo") @db.Decimal(10, 2)
  observacoes                   String?  @map("observacoes")
  situacao                      String?  @map("situacao")
  estoque                       Int?     @map("estoque")
  precosDeCusto                 Decimal? @map("precos_de_custo") @db.Decimal(10, 2)
  codNoFornecedor               String?  @map("cod_no_fornecedor")
  fornecedor                    String?  @map("fornecedor")
  localizacao                   String?  @map("localizacao")
  estoqueMaximo                 Int?     @map("estoque_maximo")
  estoqueMinimo                 Int?     @map("estoque_minimo")
  pesoLiquidoKg                 Decimal? @map("peso_liquido_kg") @db.Decimal(10, 3)
  pesoBrutoKg                   Decimal? @map("peso_bruto_kg") @db.Decimal(10, 3)
  gtinEan                       String?  @map("gtin_ean")
  gtinEanDaEmbalagem            String?  @map("gtin_ean_da_embalagem")
  larguraDoProduto              Decimal? @map("largura_do_produto") @db.Decimal(10, 2)
  alturaDoProduto               Decimal? @map("altura_do_produto") @db.Decimal(10, 2)
  profundidadeDoProduto         Decimal? @map("profundidade_do_produto") @db.Decimal(10, 2)
  dataDeValidade                String?  @map("data_de_validade")
  descricaoDoProdutoNoFornecedor String? @map("descricao_do_produto_no_fornecedor")
  descricaoComplementar         String?  @map("descricao_complementar")
  itensPorCaixa                 Int?     @map("itens_por_caixa")
  produtoVariacao               String?  @map("produto_variacao")
  tipoProducao                  String?  @map("tipo_producao")
  classeDeEnquadramentoDoIpi    String?  @map("classe_de_enquadramento_do_ipi")
  codigoListaDeServicos         String?  @map("codigo_lista_de_servicos")
  tipoDoItem                    String?  @map("tipo_do_item")
  grupoDeTags                   String?  @map("grupo_de_tags")
  tributos                      String?  @map("tributos")
  codigoPai                     String?  @map("codigo_pai")
  codigoIntegracao              String?  @map("codigo_integracao")
  grupoDeProdutos               String?  @map("grupo_de_produtos")
  cest                          String?  @map("cest")
  volumes                       Int?     @map("volumes")
  descricaoCurta                String?  @map("descricao_curta")
  crossDocking                  String?  @map("cross_docking")
  urlImagensExternas            String?  @map("url_imagens_externas")
  linkExterno                   String?  @map("link_externo")
  mesesGarantiaFornecedor       Int?     @map("meses_garantia_fornecedor")
  clonarDadosDoPai              String?  @map("clonar_dados_do_pai")
  condicaoDoProduto             String?  @map("condicao_do_produto")
  freteGratis                   String?  @map("frete_gratis")
  numeroFci                     String?  @map("numero_fci")
  video                         String?  @map("video")
  departamento                  String?  @map("departamento")
  unidadeDeMedida               String?  @map("unidade_de_medida")
  precoDeCompra                 Decimal? @map("preco_de_compra") @db.Decimal(10, 2)
  valorBaseIcsmStParaRetencao   Decimal? @map("valor_base_icsm_st_para_retencao") @db.Decimal(10, 2)
  valorIcmsStParaRetencao       Decimal? @map("valor_icms_st_para_retencao") @db.Decimal(10, 2)
  valorIcmsProprioDoSubstituto  Decimal? @map("valor_icms_proprio_do_substituto") @db.Decimal(10, 2)
  categoriaDoProduto            String?  @map("categoria_do_produto")
  informacoesAdicionais         String?  @map("informacoes_adicionais")
  
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  supplier Org            @relation("SupplierProducts", fields: [supplierOrgId], references: [id], onDelete: Cascade)
  skus     Sku[]
  images   ProductImage[]

  @@map("products")
}

model Sku {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  skuCode     String   @map("sku_code")
  variantJson Json     @default("{}") @map("variant_json")
  weightGrams Int?     @map("weight_grams")
  lengthCm    Decimal? @map("length_cm") @db.Decimal(10, 2)
  widthCm     Decimal? @map("width_cm") @db.Decimal(10, 2)
  heightCm    Decimal? @map("height_cm") @db.Decimal(10, 2)
  gtin        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  offers  SupplierOffer[]

  @@unique([productId, skuCode])
  @@map("skus")
}

model ProductImage {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String @map("product_id") @db.Uuid
  url       String
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model SupplierOffer {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skuId            String   @map("sku_id") @db.Uuid
  supplierOrgId    String   @map("supplier_org_id") @db.Uuid
  costCents        Int      @map("cost_cents")
  msrpCents        Int?     @map("msrp_cents")
  stockQty         Int      @default(0) @map("stock_qty")
  slaDays          Int      @default(2) @map("sla_days")
  shipsFrom        String?  @map("ships_from")
  allowRandomColor Boolean  @default(false) @map("allow_random_color")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  sku      Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  supplier Org @relation("SupplierOffers", fields: [supplierOrgId], references: [id], onDelete: Cascade)

  listings     Listing[]
  reservations StockReservation[]
  orderItems   MarketplaceOrderItem[]

  @@unique([skuId, supplierOrgId])
  @@map("supplier_offers")
}

model MerchantSupplier {
  merchantOrgId String                 @map("merchant_org_id") @db.Uuid
  supplierOrgId String                 @map("supplier_org_id") @db.Uuid
  status        MerchantSupplierStatus @default(PENDING)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz

  merchant Org @relation("MerchantAsMerchant", fields: [merchantOrgId], references: [id], onDelete: Cascade)
  supplier Org @relation("MerchantAsSupplier", fields: [supplierOrgId], references: [id], onDelete: Cascade)

  @@id([merchantOrgId, supplierOrgId])
  @@map("merchant_suppliers")
}

model Integration {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  provider       Provider
  status         String   @default("ACTIVE")
  credentialsEnc String   @map("credentials_enc")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider])
  @@map("integrations")
}

model Listing {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantOrgId     String    @map("merchant_org_id") @db.Uuid
  supplierOfferId   String    @map("supplier_offer_id") @db.Uuid
  provider          Provider
  externalListingId String?   @map("external_listing_id")
  title             String
  priceCents        Int       @map("price_cents")
  isActive          Boolean   @default(true) @map("is_active")
  syncStatus        String    @default("PENDING") @map("sync_status")
  lastSyncedAt      DateTime? @map("last_synced_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  merchant      Org           @relation("MerchantListings", fields: [merchantOrgId], references: [id], onDelete: Cascade)
  supplierOffer SupplierOffer @relation(fields: [supplierOfferId], references: [id], onDelete: Cascade)

  orderItems MarketplaceOrderItem[]

  @@unique([merchantOrgId, provider, externalListingId])
  @@map("listings")
}

model StockReservation {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierOfferId    String            @map("supplier_offer_id") @db.Uuid
  marketplaceOrderId String?           @map("marketplace_order_id") @db.Uuid
  qty                Int
  status             ReservationStatus @default(HELD)
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz

  supplierOffer SupplierOffer @relation(fields: [supplierOfferId], references: [id], onDelete: Cascade)

  @@map("stock_reservations")
}

model MarketplaceOrder {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantOrgId       String   @map("merchant_org_id") @db.Uuid
  provider            Provider
  externalOrderId     String   @map("external_order_id")
  status              String
  buyerName           String?  @map("buyer_name")
  shippingAddressJson Json?    @map("shipping_address_json")
  totalCents          Int?     @map("total_cents")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  merchant     Org                    @relation("MerchantOrders", fields: [merchantOrgId], references: [id], onDelete: Cascade)
  items        MarketplaceOrderItem[]
  fulfillments FulfillmentOrder[]

  @@unique([merchantOrgId, provider, externalOrderId])
  @@map("marketplace_orders")
}

model MarketplaceOrderItem {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketplaceOrderId String  @map("marketplace_order_id") @db.Uuid
  listingId          String? @map("listing_id") @db.Uuid
  supplierOfferId    String? @map("supplier_offer_id") @db.Uuid
  qty                Int
  priceCents         Int     @map("price_cents")

  order         MarketplaceOrder @relation(fields: [marketplaceOrderId], references: [id], onDelete: Cascade)
  listing       Listing?         @relation(fields: [listingId], references: [id], onDelete: SetNull)
  supplierOffer SupplierOffer?   @relation(fields: [supplierOfferId], references: [id], onDelete: SetNull)

  @@map("marketplace_order_items")
}

model FulfillmentOrder {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierOrgId      String            @map("supplier_org_id") @db.Uuid
  merchantOrgId      String            @map("merchant_org_id") @db.Uuid
  marketplaceOrderId String            @map("marketplace_order_id") @db.Uuid
  status             FulfillmentStatus @default(NEW)
  trackingCode       String?           @map("tracking_code")
  carrier            String?
  shippedAt          DateTime?         @map("shipped_at") @db.Timestamptz
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz

  supplier Org              @relation("FulfillmentSupplier", fields: [supplierOrgId], references: [id], onDelete: Cascade)
  merchant Org              @relation("FulfillmentMerchant", fields: [merchantOrgId], references: [id], onDelete: Cascade)
  order    MarketplaceOrder @relation(fields: [marketplaceOrderId], references: [id], onDelete: Cascade)

  @@map("fulfillment_orders")
}

model WebhookEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        Provider
  externalEventId String   @map("external_event_id")
  payload         Json
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz

  @@unique([provider, externalEventId])
  @@map("webhook_events")
}

model IdempotencyKey {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  key          String
  requestHash  String   @map("request_hash")
  responseJson Json?    @map("response_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key])
  @@map("idempotency_keys")
}
