# Database Configuration
DATABASE_URL=postgresql://dropship:dropship@localhost:5433/dropship

# Security - CHANGE THESE IN PRODUCTION!
# Generate strong secrets with: openssl rand -hex 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters-required
APP_ENC_KEY=your-32-char-encryption-key-change-in-production-min-32-chars

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration (comma-separated origins)
# Production example: CORS_ORIGIN=https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Frontend URL for OAuth redirects
FRONTEND_URL=http://localhost:3001

# Shopee Integration
# Get these from: https://open.shopee.com/
# 1. Register as Shopee Partner
# 2. Create a new app
# 3. Get Partner ID and Partner Key from Shopee Partner Dashboard
SHOPEE_PARTNER_ID=your-shopee-partner-id
SHOPEE_PARTNER_KEY=your-shopee-partner-key
SHOPEE_REDIRECT_URL=http://localhost:3000/integrations/shopee/callback

# Mercado Livre Integration
# Get these from: https://developers.mercadolibre.com/
MELI_CLIENT_ID=your-meli-client-id
MELI_CLIENT_SECRET=your-meli-client-secret
MELI_REDIRECT_URL=http://localhost:3000/integrations/mercadolivre/callback
