# Database Configuration
DATABASE_URL=postgresql://dropship:dropship@localhost:5433/dropship

# Security - CHANGE THESE IN PRODUCTION!
# Generate strong secrets with: openssl rand -hex 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters-required
APP_ENC_KEY=your-32-char-encryption-key-change-in-production-min-32-chars

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration (comma-separated origins)
# Production example: CORS_ORIGIN=https://app.yourdomain.com,https://admin.yourdomain.com
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Webhook Secrets (get from marketplace dashboards)
# SHOPEE_WEBHOOK_SECRET=your-shopee-secret-here
# MERCADOLIVRE_WEBHOOK_SECRET=your-ml-secret-here
